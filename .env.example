# aiohttp
APP_HOST=0.0.0.0
APP_PORT=8080
HOST_PORT=8080

# OpenAI (optional for NLP; required for LLM and Hybrid fallback)
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_SECONDS=60
MAX_QUERY_CHARS=4000
MAX_BATCH_ROWS=5000
MAX_UPLOAD_BYTES=5242880
BATCH_LLM_CONCURRENCY=4

# PostgreSQL (blank host uses the local host default)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=ario
POSTGRES_PASSWORD=
POSTGRES_DB=vehicle_matching
POSTGRES_SSL_MODE=prefer
POSTGRES_VEHICLE_TABLE=public.vehicle
POSTGRES_LISTING_TABLE=public.listing
POSTGRES_ALIAS_TABLE=
